{
  "name": "photo-flow-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 7718 --strictPort",
    "build": "tsr generate && vite build",
    "preview": "vite preview --port 7718 --strictPort",
    "lint": "oxlint src && basalt-ui check-theme",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript http://127.0.0.1:7717/openapi.json -o src/lib/api-types.ts"
  },
  "basalt": {
    "roots": ["src"],
    "exempt": ["src/lib/series.ts"]
  },
  "dependencies": {
    "@fontsource-variable/hubot-sans": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/nunito-sans": "5.2.7",
    "@mantine/core": "9.5.1",
    "@mantine/form": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@mantine/modals": "9.5.1",
    "@mantine/notifications": "9.5.1",
    "@mantine/spotlight": "9.5.1",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@visx/axis": "4.0.0",
    "@visx/curve": "4.0.0",
    "@visx/event": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@visx/threshold": "4.0.0",
    "basalt-ui": "1.13.0",
    "date-fns": "^4.1.0",
    "motion": "12.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.166.43",
    "@tanstack/router-plugin": "^1.167.35",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "openapi-typescript": "^7.8.0",
    "oxlint": "^1.60.0",
